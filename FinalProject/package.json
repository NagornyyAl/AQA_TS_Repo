{
    "name": "practice-software-testing-playwright-framework",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@11.9.0",
    "description": "TypeScript test automation framework for Practice Software Testing.",
    "scripts": {
        "clean:reports": "node ./scripts/clean-reports.mjs primary",
        "clean:reports:with-bugs": "node ./scripts/clean-reports.mjs with-bugs",
        "test": "pnpm run clean:reports && playwright test",
        "test:api": "pnpm run clean:reports && playwright test tests/api",
        "test:e2e": "pnpm run clean:reports && playwright test tests/e2e --workers=1",
        "test:contract": "pnpm run clean:reports && playwright test tests/contracts",
        "test:chromium": "pnpm run clean:reports && playwright test --project=chromium",
        "test:firefox": "pnpm run clean:reports && playwright test --project=firefox --workers=1",
        "test:webkit": "pnpm run clean:reports && playwright test --project=webkit --workers=1",
        "test:with-bugs": "pnpm run clean:reports:with-bugs && playwright test --config=playwright.with-bugs.config.ts --workers=1",
        "test:defects": "pnpm run test:with-bugs",
        "test:smoke": "pnpm run clean:reports && playwright test --grep @smoke",
        "test:regression": "pnpm run clean:reports && playwright test --grep @regression",
        "test:headed": "pnpm run clean:reports && playwright test --headed",
        "test:ui": "pnpm run clean:reports && playwright test --ui",
        "report": "playwright show-report",
        "report:with-bugs": "playwright show-report playwright-report-with-bugs",
        "report:allure": "allure generate allure-results --clean --output allure-report",
        "report:allure:open": "allure open allure-report",
        "report:allure:with-bugs": "allure generate allure-results-with-bugs --clean --output allure-report-with-bugs",
        "report:allure:with-bugs:open": "allure open allure-report-with-bugs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@pact-foundation/pact": "^16.5.0",
        "@playwright/test": "^1.61.1",
        "@stylistic/eslint-plugin": "^5.6.1",
        "@types/node": "^24.0.0",
        "allure-commandline": "^2.43.0",
        "allure-playwright": "^3.10.2",
        "eslint": "^9.39.1",
        "eslint-plugin-unicorn": "^62.0.0",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.47.0",
        "zod": "^4.1.5"
    }
}
